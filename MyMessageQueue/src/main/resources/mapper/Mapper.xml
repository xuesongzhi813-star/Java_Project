<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mymessagequeue.mqserver.mapper.MetaMapper">
    <update id="createExchangeTable">
        create table if not exists Exchange(
        name varchar(50) primary key,
        exchangeType int,
        durable boolean,
        autoDelete boolean,
        arguments varchar(50)
        );
    </update>

    <update id="createMessageQueueTable">
        create table if not exists Queue(
        name varchar(50) primary key,
        durable boolean,
        exclusive boolean,
        autoDelete boolean,
        arguments varchar(50)
        );
    </update>

    <update id="createBindingTable">
        create table if not exists Binding(
        ExchangeName varchar(50),
        MessageQueueName varchar(50),
        bindingKey varchar(50)
        );
    </update>

<!--    parameterType：填参数的类型-->
    <insert id="insertExchange" parameterType="org.example.mymessagequeue.mqserver.coreentity.Exchange">
        insert into Exchange values(#{name},#{exchangeType},#{durable},#{autoDelete},#{arguments});
    </insert>

    <insert id="insertMessageQueue" parameterType="org.example.mymessagequeue.mqserver.coreentity.MessageQueue">
        insert into Queue values(#{name},#{durable},#{exclusive},#{autoDelete},#{arguments});
    </insert>

    <insert id="insertBinding" parameterType="org.example.mymessagequeue.mqserver.coreentity.Binding">
        insert into Binding values(#{ExchangeName},#{MessageQueueName},#{bindingKey});
    </insert>

    <delete id="deleteExchange" parameterType="string">
        delete from Exchange where name=#{name};
    </delete>

    <delete id="deleteMessageQueue" parameterType="string">
        delete from Queue where name=#{name};
    </delete>

    <delete id="deleteBinding" parameterType="org.example.mymessagequeue.mqserver.coreentity.Binding">
        delete from Binding where ExchangeName=#{ExchangeName} and MessageQueueName=#{MessageQueueName};
    </delete>

<!--    resultType：填返回参数类型-->
    <select id="selectAllExchange" resultType="org.example.mymessagequeue.mqserver.coreentity.Exchange">
        select * from Exchange;
    </select>

    <select id="selectAllQueue" resultType="org.example.mymessagequeue.mqserver.coreentity.MessageQueue">
        select * from Queue;
    </select>

    <select id="selectAllBinding" resultType="org.example.mymessagequeue.mqserver.coreentity.Binding">
        select * from Binding;
    </select>
</mapper>